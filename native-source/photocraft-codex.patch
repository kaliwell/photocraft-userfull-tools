+    /// Explicit export ignores the preference that disables automatic Copy mirroring.
+    /// No intermediate file, selection change, document edit, or history step is needed.
+    pub(super) fn export_document_clipboard(&mut self, params: &serde_json::Value) -> Result<serde_json::Value, String> {
+        if self.services.clipboard_set_image.is_none() {
+            return Err(tl!("System image clipboard is unavailable").into());
+        }
+        let previous = self.session.clipboard.clone();
+        self.session.execute("file.export.clipboard", params.clone()).map_err(|e| e.to_string())?;
+        let result = (|| {
+            let clip = self.session.clipboard.as_ref().ok_or("No image to export")?;
+            let b = clip.bounds;
+            let len = (b.width() as usize).checked_mul(b.height() as usize).and_then(|n| n.checked_mul(4)).ok_or("Clipboard image is too large")?;
+            let mut bytes = Vec::new();
+            bytes.try_reserve_exact(len).map_err(|_| "Not enough memory for the clipboard image")?;
+            bytes.resize(len, 0u8);
+            clip.surface.read_rgba8_into(b, bytes.as_chunks_mut::<4>().0);
+            let set = self.services.clipboard_set_image.as_mut().ok_or("System image clipboard is unavailable")?;
+            set(b.width(), b.height(), &bytes)?;
+            self.os_clip_sig = Some(clip_signature(b.width(), b.height(), &bytes));
+            self.clip_external = false;
+            self.clip_unmirrored = false;
+            Ok(serde_json::json!({"width":b.width(),"height":b.height(),"copied":true}))
+        })();
+        if result.is_err() {
+            self.session.clipboard = previous;
+        }
+        result
+    }
