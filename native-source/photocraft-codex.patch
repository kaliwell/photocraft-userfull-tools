new file mode 100644
index 0000000..37bdd1c
--- /dev/null
+++ b/crates/ui-egui/src/long_cut.rs
@@ -0,0 +1,545 @@
+//! Independently implemented long-image cutter. No LongPicCutter source is included.
+use crate::PhotocraftApp;
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use std::sync::{Arc, mpsc};
+
+const MAX_CUTS: usize = 1024;
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Plan {
+    version: u32,
+    width: u32,
+    height: u32,
+    cuts: Vec<u32>,
+}
+impl Plan {
+    fn parse(bytes: &[u8], width: u32, height: u32) -> Result<Self, String> {
+        if bytes.len() > 65536 {
+            return Err("Plan exceeds 64 KiB".into());
+        }
+        let value: Value = serde_json::from_slice(bytes).map_err(|e| e.to_string())?;
+        let mut plan: Self = if value.get("app").and_then(Value::as_str) == Some("LongPicCutter") {
+            serde_json::from_value(json!({"version":value["version"],"width":value["image"]["width"],"height":value["image"]["height"],"cuts":value["lines"]}))
+                .map_err(|e| e.to_string())?
+        } else {
+            serde_json::from_value(value).map_err(|e| e.to_string())?
+        };
+        plan.validate(width, height)?;
+        Ok(plan)
+    }
+    fn external(&self) -> Value {
+        json!({"app":"LongPicCutter","version":1,"image":{"width":self.width,"height":self.height,"name":"PhotoCraft canvas"},"lines":self.cuts})
+    }
+    fn validate(&mut self, width: u32, height: u32) -> Result<(), String> {
+        if self.version != 1 || self.width != width || self.height != height || self.cuts.len() > MAX_CUTS {
+            return Err("切割方案版本、图片尺寸不匹配或切割线过多 / Incompatible cutting plan".into());
+        }
+        if self.cuts.iter().any(|&y| y == 0 || y >= height) {
+            return Err("切割线必须位于图片内部 / Cut is outside the image".into());
+        }
+        self.cuts.sort_unstable();
+        self.cuts.dedup();
+        Ok(())
+    }
+    fn ranges(&self) -> Vec<(u32, u32)> {
+        let mut edges = vec![0];
+        edges.extend(&self.cuts);
+        edges.push(self.height);
+        edges.windows(2).map(|e| (e[0], e[1])).collect()
+    }
+}
+
+pub struct State {
+    plan: Plan,
+    pixels: Arc<Vec<u8>>,
+    texture: Option<egui::TextureHandle>,
+    undo: Vec<Vec<u32>>,
+    hover: Option<u32>,
+    drag: Option<usize>,
+    drag_before: Vec<u32>,
+    cache: Option<std::path::PathBuf>,
+    message: String,
+    confirm_clear: bool,
+    confirm_import: Option<Plan>,
+    export: Option<mpsc::Receiver<Result<Vec<u8>, String>>>,
+    source_rect: Option<egui::Rect>,
+}
+
+fn cache_path(width: u32, height: u32, pixels: &[u8]) -> Option<std::path::PathBuf> {
+    use std::hash::{Hash, Hasher};
+    let mut h = std::collections::hash_map::DefaultHasher::new();
+    (width, height, pixels).hash(&mut h);
+    std::env::var_os("PHOTOCRAFT_CONFIG_DIR").map(|p| std::path::PathBuf::from(p).join("long-cut").join(format!("{:016x}.json", h.finish())))
+}
+
+pub fn open(app: &mut PhotocraftApp) -> Result<Value, String> {
+    // Render through the existing compositor and restore the internal clipboard immediately.
+    let previous = app.session.clipboard.take();
+    let rendered = app.session.execute("file.export.clipboard", json!({}));
+    let clip = app.session.clipboard.take();
+    app.session.clipboard = previous;
+    rendered.map_err(|e| e.to_string())?;
+    let clip = clip.ok_or("No canvas")?;
+    let (width, height) = (clip.bounds.width(), clip.bounds.height());
+    let mut pixels = vec![0; width as usize * height as usize * 4];
+    clip.surface.read_rgba8_into(clip.bounds, pixels.as_chunks_mut::<4>().0);
+    let cache = cache_path(width, height, &pixels);
+    let mut plan = Plan { version: 1, width, height, cuts: vec![] };
+    if let Some(path) = &cache
+        && std::fs::metadata(path).is_ok_and(|m| m.len() <= 65536)
+        && let Ok(bytes) = std::fs::read(path)
+        && bytes.len() <= 65536
+        && let Ok(mut saved) = serde_json::from_slice::<Plan>(&bytes)
+        && saved.validate(width, height).is_ok()
+    {
+        plan = saved;
+    }
+    app.long_cut = Some(State {
+        plan,
+        pixels: Arc::new(pixels),
+        texture: None,
+        undo: vec![],
+        hover: None,
+        drag: None,
+        drag_before: vec![],
+        cache,
+        message: String::new(),
+        confirm_clear: false,
+        confirm_import: None,
+        export: None,
+        source_rect: None,
+    });
+    Ok(json!({"width":width,"height":height,"open":true}))
+}
+
+impl State {
+    fn remember(&mut self) {
+        self.undo.push(self.plan.cuts.clone());
+        if self.undo.len() > 100 {
+            self.undo.remove(0);
+        }
+    }
+    fn persist(&mut self) {
+        if let Some(path) = &self.cache {
+            let result = (|| -> Result<(), String> {
+                std::fs::create_dir_all(path.parent().ok_or("No cache directory")?).map_err(|e| e.to_string())?;
+                let bytes = serde_json::to_vec(&self.plan).map_err(|e| e.to_string())?;
+                std::fs::write(path, bytes).map_err(|e| e.to_string())
+            })();
+            if let Err(e) = result {
+                self.message = format!("自动保存失败 / Auto-save failed: {e}");
+            }
+        }
+    }
+    fn add(&mut self, y: u32) {
+        if y > 0 && y < self.plan.height && self.plan.cuts.len() < MAX_CUTS && !self.plan.cuts.contains(&y) {
+            self.remember();
+            self.plan.cuts.push(y);
+            self.plan.cuts.sort_unstable();
+            self.persist();
+        }
+    }
+    fn texture(&mut self, ctx: &egui::Context) -> &egui::TextureHandle {
+        self.texture.get_or_insert_with(|| {
+            let scale = (600.0 / self.plan.width as f64).min(8192.0 / self.plan.height as f64).min(1.0);
+            let w = (self.plan.width as f64 * scale).round().max(1.0) as usize;
+            let h = (self.plan.height as f64 * scale).round().max(1.0) as usize;
+            let mut preview = vec![0; w * h * 4];
+            for y in 0..h {
+                for x in 0..w {
+                    let source = ((y * self.plan.height as usize / h) * self.plan.width as usize + x * self.plan.width as usize / w) * 4;
+                    preview[(y * w + x) * 4..(y * w + x + 1) * 4].copy_from_slice(&self.pixels[source..source + 4]);
+                }
+            }
+            ctx.load_texture("long-cut-preview", egui::ColorImage::from_rgba_unmultiplied([w, h], &preview), egui::TextureOptions::LINEAR)
+        })
+    }
+}
+
+fn save(app: &mut PhotocraftApp, name: &str, bytes: Vec<u8>) -> Result<Value, String> {
+    app.pick_save(name, move |app, path| {
+        let write = app.services.write.as_mut().ok_or("File writing is unavailable")?;
+        write(&path, &bytes)?;
+        Ok(json!({"saved":path}))
+    })
+}
+
+pub fn show(app: &mut PhotocraftApp, ctx: &egui::Context) {
+    let Some(mut state) = app.long_cut.take() else { return };
+    let mut opened = true;
+    let mut action = "";
+    let mut ready = None;
+    if let Some(rx) = &state.export {
+        match rx.try_recv() {
+            Ok(result) => {
+                ready = Some(result);
+                state.export = None;
+            }
+            Err(mpsc::TryRecvError::Disconnected) => {
+                state.message = "导出任务意外结束 / Export worker stopped".into();
+                state.export = None;
+            }
+            Err(mpsc::TryRecvError::Empty) => {
+                ctx.request_repaint_after(std::time::Duration::from_millis(100));
+            }
+        }
+    }
+    egui::Window::new("长图切割 / Long image cutter").id(egui::Id::unique("long-cut")).open(&mut opened).default_size(egui::vec2(950.0, 650.0)).show(
+        ctx,
+        |ui| {
+            ui.label("当前画布快照 · 点击或 S 标记 · 拖动红线调整 · Delete 删除附近线 · Ctrl+Z 撤销");
+            ui.label("Snapshot of current canvas · Click/S: mark · Drag line: move · Delete: remove · Ctrl+Z: undo");
+            ui.horizontal_wrapped(|ui| {
+                if ui.button("标记 / Mark").clicked()
+                    && let Some(y) = state.hover
+                {
+                    state.add(y);
+                }
+                if ui.add_enabled(!state.undo.is_empty(), egui::Button::new("撤销 / Undo")).clicked() {
+                    action = "undo";
+                }
+                if ui.button("清空 / Clear").clicked() {
+                    state.confirm_clear = true;
+                }
+                if ui.button("导入方案 / Import JSON").clicked() {
+                    action = "import";
+                }
+                if ui.button("导出方案 / Export JSON").clicked() {
+                    action = "plan";
+                }
+                if ui.add_enabled(state.export.is_none(), egui::Button::new("导出 PNG ZIP / Export ZIP")).clicked() {
+                    action = "zip";
+                }
+            });
+            if state.confirm_clear {
+                ui.horizontal(|ui| {
+                    ui.label("清空全部切割线？ / Clear all cuts?");
+                    if ui.button("确认 / Confirm").clicked() {
+                        state.remember();
+                        state.plan.cuts.clear();
+                        state.persist();
+                        state.confirm_clear = false;
+                    }
+                    if ui.button("取消 / Cancel").clicked() {
+                        state.confirm_clear = false;
+                    }
+                });
+            }
+            if state.confirm_import.is_some() {
+                ui.horizontal(|ui| {
+                    ui.label("替换当前方案？ / Replace current cuts?");
+                    if ui.button("替换 / Replace").clicked() {
+                        state.remember();
+                        if let Some(plan) = state.confirm_import.take() {
+                            state.plan = plan;
+                        }
+                        state.persist();
+                    }
+                    if ui.button("取消 / Cancel").clicked() {
+                        state.confirm_import = None;
+                    }
+                });
+            }
+            ui.label(format!("{} × {} px · {} 段 / pieces · {}", state.plan.width, state.plan.height, state.plan.cuts.len() + 1, state.message));
+            if state.export.is_some() {
+                ui.spinner();
+                ui.label("正在编码切图 / Encoding slices…");
+            }
+            let texture = state.texture(ctx).id();
+            let width = ((ui.available_width() - 35.0) / 2.0).max(100.0);
+            let height = width * state.plan.height as f32 / state.plan.width as f32;
+            ui.columns(2, |cols| {
+                cols[0].label("原图与切割线 / Source");
+                egui::ScrollArea::both().id_salt("long-cut-source").max_height(480.0).show(&mut cols[0], |ui| {
+                    let response = ui.add(egui::Image::new((texture, egui::vec2(width, height))).sense(egui::Sense::click_and_drag()));
+                    let rect = response.rect;
+                    state.source_rect = Some(rect);
+                    let position = ctx.pointer_hover_pos().filter(|p| rect.contains(*p) && ui.clip_rect().contains(*p));
+                    if let Some(pos) = position {
+                        let y = ((pos.y - rect.top()) / height * state.plan.height as f32).floor().clamp(0.0, state.plan.height as f32) as u32;
+                        state.hover = Some(y);
+                        let near = state.plan.cuts.iter().position(|&c| (c as f32 - y as f32).abs() * height / state.plan.height as f32 <= 8.0);
+                        if response.drag_started() {
+                            state.drag = ctx.input(|i| i.pointer.press_origin()).and_then(|start| {
+                                state.plan.cuts.iter().position(|&row| {
+                                    (rect.top() + row as f32 / state.plan.height as f32 * height - start.y).abs() <= 8.0
+                                })
+                            });
+                            state.drag_before = state.plan.cuts.clone();
+                        }
+                        if response.dragged()
+                            && let Some(index) = state.drag
+                        {
+                            let low = if index == 0 { 1 } else { state.plan.cuts[index - 1] + 1 };
+                            let high = state.plan.cuts.get(index + 1).copied().unwrap_or(state.plan.height) - 1;
+                            state.plan.cuts[index] = y.clamp(low, high);
+                        }
+                        if response.clicked() || (!ctx.egui_wants_keyboard_input() && ui.input_mut(|i| i.consume_key(egui::Modifiers::NONE, egui::Key::S))) {
+                            state.add(y);
+                        }
+                        if !ctx.egui_wants_keyboard_input()
+                            && ui.input_mut(|i| i.consume_key(egui::Modifiers::NONE, egui::Key::Delete))
+                            && let Some(index) = near
+                        {
+                            state.remember();
+                            state.plan.cuts.remove(index);
+                            state.persist();
+                        }
+                        let py = rect.top() + y as f32 / state.plan.height as f32 * height;
+                        ui.painter().hline(rect.x_range(), py, egui::Stroke::new(1.0, egui::Color32::LIGHT_BLUE));
+                        response.clone().on_hover_text(format!("y = {y} px"));
+                    }
+                    if response.drag_stopped() && state.drag.take().is_some() {
+                        state.undo.push(std::mem::take(&mut state.drag_before));
+                        state.plan.cuts.sort_unstable();
+                        state.plan.cuts.dedup();
+                        state.persist();
+                    }
+                    for &y in &state.plan.cuts {
+                        let py = rect.top() + y as f32 / state.plan.height as f32 * height;
+                        ui.painter().hline(rect.x_range(), py, egui::Stroke::new(2.0, egui::Color32::RED));
+                    }
+                    if position.is_some() && !ctx.egui_wants_keyboard_input() {
+                        if ui.input_mut(|i| i.consume_key(egui::Modifiers::COMMAND, egui::Key::Z)) {
+                            action = "undo";
+                        }
+                        if ui.input_mut(|i| i.consume_key(egui::Modifiers::COMMAND, egui::Key::S)) {
+                            action = "plan";
+                        }
+                    }
+                });
+                cols[1].label("切图预览 / Slices");
+                egui::ScrollArea::both().id_salt("long-cut-slices").max_height(480.0).show(&mut cols[1], |ui| {
+                    for (i, (a, b)) in state.plan.ranges().iter().enumerate() {
+                        let uv = egui::Rect::from_min_max(
+                            egui::pos2(0.0, *a as f32 / state.plan.height as f32),
+                            egui::pos2(1.0, *b as f32 / state.plan.height as f32),
+                        );
+                        ui.label(format!("{:03} · {} × {} px", i + 1, state.plan.width, b - a));
+                        ui.add(egui::Image::new((texture, egui::vec2(width, (b - a) as f32 * width / state.plan.width as f32))).uv(uv));
+                    }
+                });
+            });
+        },
+    );
+    if action == "undo"
+        && let Some(cuts) = state.undo.pop()
+    {
+        state.plan.cuts = cuts;
+        state.persist();
+    }
+    if action == "zip" {
+        let (tx, rx) = mpsc::channel();
+        state.export = Some(rx);
+        let plan = state.plan.clone();
+        let pixels = state.pixels.clone();
+        let repaint = ctx.clone();
+        #[cfg(not(target_arch = "wasm32"))]
+        std::thread::spawn(move || {
+            let _ = tx.send(archive(&plan, &pixels));
+            repaint.request_repaint();
+        });
+        #[cfg(target_arch = "wasm32")]
+        {
+            let _ = tx.send(archive(&plan, &pixels));
+            repaint.request_repaint();
+        }
+    }
+    let plan_bytes = (action == "plan").then(|| serde_json::to_vec_pretty(&state.plan.external()).map_err(|e| e.to_string()));
+    app.long_cut = opened.then_some(state);
+    let result = if action == "import" {
+        app.pick_file_bytes_filtered(&["json"], |app, _, bytes| {
+            if bytes.len() > 65536 {
+                return Err("切割方案过大 / Plan too large".into());
+            }
+            let state = app.long_cut.as_mut().ok_or("Cutter was closed")?;
+            let plan = Plan::parse(&bytes, state.plan.width, state.plan.height)?;
+            state.confirm_import = Some(plan);
+            Ok(Value::Null)
+        })
+    } else if let Some(bytes) = plan_bytes {
+        bytes.and_then(|b| save(app, "cut-plan.json", b))
+    } else if let Some(bytes) = ready {
+        bytes.and_then(|b| save(app, "slices.zip", b))
+    } else {
+        Ok(Value::Null)
+    };
+    if let Err(e) = result
+        && e != crate::file_dialog::CANCELLED
+        && let Some(state) = app.long_cut.as_mut()
+    {
+        state.message = e;
+    }
+}
+
+/// Standard stored ZIP, PNG payloads are already compressed. Bounded to classic ZIP limits.
+fn archive(plan: &Plan, pixels: &[u8]) -> Result<Vec<u8>, String> {
+    let mut checked = plan.clone();
+    checked.validate(plan.width, plan.height)?;
+    let plan = &checked;
+    if pixels.len() != plan.width as usize * plan.height as usize * 4 {
+        return Err("Invalid RGBA length".into());
+    }
+    let mut output = Vec::new();
+    let mut directory = Vec::new();
+    for (index, (a, b)) in plan.ranges().into_iter().enumerate() {
+        let stride = plan.width as usize * 4;
+        let image = photocraft_codecs::Image::from_u8(
+            plan.width,
+            b - a,
+            photocraft_codecs::ChannelLayout::Rgba,
+            pixels[a as usize * stride..b as usize * stride].to_vec(),
+        )
+        .map_err(|e| e.to_string())?;
+        let bytes = photocraft_codecs::encode(&image, photocraft_codecs::Format::Png, &Default::default()).map_err(|e| e.to_string())?;
+        if output.len() + bytes.len() > 512 * 1024 * 1024 {
+            return Err("ZIP exceeds 512 MiB limit".into());
+        }
+        let name = format!("slice-{:03}.png", index + 1);
+        let offset = output.len() as u32;
+        let size = bytes.len() as u32;
+        let mut crc = flate2::Crc::new();
+        crc.update(&bytes);
+        let crc = crc.sum();
+        put32(&mut output, 0x04034b50);
+        put16(&mut output, 20);
+        put16(&mut output, 0);
+        put16(&mut output, 0);
+        put16(&mut output, 0);
+        put16(&mut output, 33);
+        put32(&mut output, crc);
+        put32(&mut output, size);
+        put32(&mut output, size);
+        put16(&mut output, name.len() as u16);
+        put16(&mut output, 0);
+        output.extend(name.as_bytes());
+        output.extend(bytes);
+        put32(&mut directory, 0x02014b50);
+        put16(&mut directory, 20);
+        put16(&mut directory, 20);
+        put16(&mut directory, 0);
+        put16(&mut directory, 0);
+        put16(&mut directory, 0);
+        put16(&mut directory, 33);
+        put32(&mut directory, crc);
+        put32(&mut directory, size);
+        put32(&mut directory, size);
+        put16(&mut directory, name.len() as u16);
+        put16(&mut directory, 0);
+        put16(&mut directory, 0);
+        put16(&mut directory, 0);
+        put16(&mut directory, 0);
+        put32(&mut directory, 0);
+        put32(&mut directory, offset);
+        directory.extend(name.as_bytes());
+    }
+    let offset = output.len() as u32;
+    let size = directory.len() as u32;
+    output.extend(directory);
+    put32(&mut output, 0x06054b50);
+    put16(&mut output, 0);
+    put16(&mut output, 0);
+    put16(&mut output, plan.cuts.len() as u16 + 1);
+    put16(&mut output, plan.cuts.len() as u16 + 1);
+    put32(&mut output, size);
+    put32(&mut output, offset);
+    put16(&mut output, 0);
+    Ok(output)
+}
+fn put16(out: &mut Vec<u8>, n: u16) {
+    out.extend(n.to_le_bytes());
+}
+fn put32(out: &mut Vec<u8>, n: u32) {
+    out.extend(n.to_le_bytes());
+}
+
+pub fn inspect(app: &PhotocraftApp) -> Value {
+    app.long_cut
+        .as_ref()
+        .map(|s| json!({"open":true,"width":s.plan.width,"height":s.plan.height,"cuts":s.plan.cuts,"pieces":s.plan.cuts.len()+1,"busy":s.export.is_some(),"sourceRect":s.source_rect.map(|r|[r.min.x,r.min.y,r.width(),r.height()])}))
+        .unwrap_or(json!({"open":false}))
+}
