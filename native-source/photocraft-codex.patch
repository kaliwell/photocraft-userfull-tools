+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn fast_drag_uses_press_origin_and_cannot_cross_adjacent_cuts() {
+        let mut app=PhotocraftApp::new(photocraft_engine::Session::new(),crate::Services::default());
+        app.run("file.new",json!({"width":240,"height":1200})).unwrap();open(&mut app).unwrap();
+        {let state=app.long_cut.as_mut().unwrap();state.cache=None;state.add(80);state.add(120);}
+        let ctx=egui::Context::default();
+        let draw=|app:&mut PhotocraftApp,events| {
+            let raw=egui::RawInput{screen_rect:Some(egui::Rect::from_min_size(egui::Pos2::ZERO,egui::vec2(1440.0,900.0))),events,..Default::default()};
+            let mut out=ctx.run_ui(raw,|_|show(app,&ctx));out.textures_delta.clear();
+        };
+        draw(&mut app,vec![]);draw(&mut app,vec![]);
+        let rect=app.long_cut.as_ref().unwrap().source_rect.unwrap();
+        let point=|row:f32|egui::pos2(rect.center().x,rect.top()+row/1200.0*rect.height());
+        let press=point(80.0);let destination=point(150.0);
+        draw(&mut app,vec![egui::Event::PointerMoved(press),egui::Event::PointerButton{pos:press,button:egui::PointerButton::Primary,pressed:true,modifiers:egui::Modifiers::NONE}]);
+        draw(&mut app,vec![egui::Event::PointerMoved(destination)]);
+        draw(&mut app,vec![egui::Event::PointerButton{pos:destination,button:egui::PointerButton::Primary,pressed:false,modifiers:egui::Modifiers::NONE}]);
+        assert_eq!(app.long_cut.as_ref().unwrap().plan.cuts,vec![119,120]);
+    }
+    #[test]
+    fn imports_longpic_plans_and_rejects_fractional_or_foreign_dimensions() {
+        let p = Plan { version: 1, width: 24, height: 120, cuts: vec![20, 80] };
+        let bytes = serde_json::to_vec(&p.external()).unwrap();
+        assert_eq!(Plan::parse(&bytes, 24, 120).unwrap().cuts, vec![20, 80]);
+        assert!(Plan::parse(&bytes, 25, 120).is_err());
+        let invalid = br#"{"app":"LongPicCutter","version":1,"image":{"width":24,"height":120},"lines":[1.5]}"#;
+        assert!(Plan::parse(invalid, 24, 120).is_err());
+    }
+    #[test]
+    fn snapshot_preserves_clipboard_selection_document_and_history() {
+        let mut app = PhotocraftApp::new(photocraft_engine::Session::new(), crate::Services::default());
+        app.run("file.new", json!({"width":3,"height":2})).unwrap();
+        app.session.execute("file.export.clipboard", json!({})).unwrap();
+        let clipboard_bounds = app.session.clipboard.as_ref().unwrap().bounds;
+        app.run("file.new", json!({"width":24,"height":120})).unwrap();
+        app.run("select.rect", json!({"x":2,"y":3,"width":5,"height":9})).unwrap();
+        let before = app.session.execute("document.inspect", json!({})).unwrap();
+        open(&mut app).unwrap();
+        let after = app.session.execute("document.inspect", json!({})).unwrap();
+        assert_eq!(before, after);
+        assert_eq!(app.session.clipboard.as_ref().unwrap().bounds, clipboard_bounds);
+        let state = app.long_cut.as_mut().unwrap();
+        state.cache = None;
+        state.add(30);
+        state.add(30);
+        state.add(0);
+        state.add(120);
+        assert_eq!(state.plan.cuts, vec![30]);
+        state.plan.cuts = state.undo.pop().unwrap();
+        assert!(state.plan.cuts.is_empty());
+    }
+    #[test]
+    fn cuts_cover_every_row_and_reject_foreign_plans() {
+        let mut p = Plan { version: 1, width: 4, height: 7, cuts: vec![5, 2, 2] };
+        p.validate(4, 7).unwrap();
+        assert_eq!(p.ranges(), vec![(0, 2), (2, 5), (5, 7)]);
+        assert!(p.validate(5, 7).is_err());
+        p.cuts = vec![0];
+        assert!(p.validate(4, 7).is_err());
+    }
+    #[test]
+    fn png_zip_contains_original_rows_without_gaps() {
+        let p = Plan { version: 1, width: 3, height: 7, cuts: vec![2, 5] };
+        let pixels: Vec<u8> = (0..21).flat_map(|i| [i as u8, 80, 100, 128]).collect();
+        let zip = archive(&p, &pixels).unwrap();
+        let mut pos = 0;
+        let mut reconstructed = vec![];
+        while &zip[pos..pos + 4] == b"PK\x03\x04" {
+            let len = u32::from_le_bytes(zip[pos + 18..pos + 22].try_into().unwrap()) as usize;
+            let names = u16::from_le_bytes(zip[pos + 26..pos + 28].try_into().unwrap()) as usize;
+            let start = pos + 30 + names;
+            let image = photocraft_codecs::decode(&zip[start..start + len]).unwrap();
+            reconstructed.extend(image.to_rgba8());
+            pos = start + len;
+        }
+        assert_eq!(reconstructed, pixels);
+        assert_eq!(&zip[zip.len() - 22..zip.len() - 18], b"PK\x05\x06");
+    }
+}
