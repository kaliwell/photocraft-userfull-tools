@@ -0,0 +1,118 @@
+//! Export the entire visible canvas to the session clipboard without changing the document.
+
+use photocraft_color::{ColorMode, PixelFormat};
+use serde_json::{Value, json};
+
+use crate::commands::CommandSpec;
+use crate::edit_cmds::Clip;
+use crate::{EngineError, Result, Session};
+
+pub const EXPORT: &str = "file.export.clipboard";
+const MAX_PIXELS: u64 = 64_000_000;
+
+/// Render without changing the document. The desktop bridge restores the previous session
+/// clipboard if the operating system refuses the image.
+fn prepare(s: &Session, params: &Value) -> Result<Clip> {
+    if !params.is_null() && !params.as_object().is_some_and(|object| object.is_empty()) {
+        return Err(EngineError::Other("Export to Clipboard expects an empty parameter object".into()));
+    }
+    let state = s.active().ok_or(EngineError::NoDocument)?;
+    let doc = &state.doc;
+    let bounds = doc.bounds();
+    let pixels = u64::from(bounds.width()) * u64::from(bounds.height());
+    if bounds.is_empty() || pixels > MAX_PIXELS {
+        return Err(EngineError::Other("Export to Clipboard requires a nonempty canvas of at most 64 million pixels".into()));
+    }
+    crate::allocation::checkpoint("exporting to the clipboard")?;
+    // The shared compositor handles the source's colour mode and depth, masks, opacity,
+    // blend modes and visibility. OS clipboards receive RGBA, not document-native channels.
+    let surface = photocraft_compose::flatten_to_surface(doc, PixelFormat::new(ColorMode::Rgb, doc.depth, true), None);
+    Ok(Clip { surface, bounds, layers: None, resolution: Some(doc.resolution_dpi), source: Some(doc.id) })
+}
+
+pub fn specs() -> Vec<CommandSpec> {
+    vec![CommandSpec {
+        id: EXPORT,
+        label: "Export to Clipboard",
+        menu: &["File", "Export"],
+        shortcut: None,
+        params: "{} → {width,height}; full visible canvas, ignoring the selection; desktop writes an RGBA8 system clipboard image",
+        enabled: |s| s.active().map(|_| ()).ok_or_else(|| "no document open".into()),
+        run: |s, p| {
+            let clip = prepare(s, p)?;
+            let result = json!({"width": clip.bounds.width(), "height": clip.bounds.height()});
+            s.clipboard = Some(clip);
+            Ok(result)
+        },
+        journal: false,
+    }]
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use photocraft_color::SampleType;
+    use photocraft_doc::{Document, Layer};
+    use photocraft_geom::{Rect, Size};
+    use photocraft_raster::Surface;
+
+    #[test]
+    fn full_canvas_preserves_selection_history_and_transparency_at_all_depths() {
+        for depth in [SampleType::U8, SampleType::U16, SampleType::F32] {
+            let mut doc = Document::new("Clipboard", Size::new(12, 10), ColorMode::Rgb, depth);
+            let mut layer = Layer::raster("Visible", doc.pixel_format());
+            layer.surface_mut().unwrap().fill_rect(Rect::new(2, 2, 8, 8), &[1.0, 0.0, 0.0, 0.5]);
+            doc.layers.push(layer);
+            let mut second = Layer::raster("Second visible layer", doc.pixel_format());
+            second.surface_mut().unwrap().fill_rect(Rect::new(10, 8, 12, 10), &[0.0, 0.0, 1.0, 1.0]);
+            doc.layers.push(second);
+            let mut hidden = Layer::raster("Hidden", doc.pixel_format());
+            hidden.surface_mut().unwrap().fill_rect(doc.bounds(), &[0.0, 1.0, 0.0, 1.0]);
+            hidden.visible = false;
+            doc.layers.push(hidden);
+            let mut selection = Surface::new(PixelFormat::GRAY8);
+            selection.fill_rect(Rect::new(0, 0, 1, 1), &[1.0]);
+            doc.selection = Some(selection);
+            let mut s = Session::new();
+            s.add_document(doc, None);
+            let before = s.active().unwrap().doc.clone();
+            let revision = s.active().unwrap().revision;
+            let history = s.active().unwrap().history.past_len();
+            let result = s.execute(EXPORT, json!({})).unwrap();
+            assert_eq!(result, json!({"width":12,"height":10}));
+            let clip = s.clipboard.as_ref().unwrap();
+            assert_eq!(clip.bounds, Rect::new(0, 0, 12, 10));
+            assert_eq!(clip.surface.rgba(0, 0)[3], 0.0);
+            let p = clip.surface.rgba(4, 4);
+            assert!(p[0] > 0.99 && p[1] < 0.01 && (p[3] - 0.5).abs() < 0.01);
+            assert!(clip.surface.rgba(11, 9)[2] > 0.99);
+            assert_eq!(s.active().unwrap().doc, before);
+            assert_eq!(s.active().unwrap().revision, revision);
+            assert_eq!(s.active().unwrap().history.past_len(), history);
+        }
+    }
+
+    #[test]
+    fn transparent_canvas_is_an_image_and_invalid_requests_preserve_previous_clip() {
+        let mut s = Session::new();
+        assert!(s.execute(EXPORT, json!({})).is_err());
+        s.add_document(Document::new("Empty", Size::new(4, 3), ColorMode::Rgb, SampleType::U8), None);
+        s.execute(EXPORT, json!({})).unwrap();
+        assert_eq!(s.clipboard.as_ref().unwrap().bounds, Rect::new(0, 0, 4, 3));
+        for bad in [json!(true), json!([]), json!({"path":"unused.png"}), json!({"selection":true})] {
+            assert!(s.execute(EXPORT, bad).is_err());
+            assert_eq!(s.clipboard.as_ref().unwrap().bounds, Rect::new(0, 0, 4, 3));
+        }
+        crate::allocation::fail_next_for_test();
+        assert!(s.execute(EXPORT, json!({})).is_err());
+        assert_eq!(s.clipboard.as_ref().unwrap().bounds, Rect::new(0, 0, 4, 3));
+    }
+
+    #[test]
+    fn oversized_canvas_is_refused_before_rendering() {
+        let mut s = Session::new();
+        s.add_document(Document::new("Large", Size::new(10_000, 10_000), ColorMode::Rgb, SampleType::U8), None);
+        assert!(s.execute(EXPORT, json!({})).is_err());
+        assert!(s.clipboard.is_none());
+    }
+}
