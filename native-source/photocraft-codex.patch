+/// Two-pass distance to the nearest transparent pixel. The outermost covered
+/// pixel is zero, so a pre-clipped layer cannot end with a half-opaque seam.
+fn inward_fade(values: &mut [f32], w: usize, h: usize, radius: f32) {
+    if w == 0 || h == 0 || values.len() != w.saturating_mul(h) || radius <= 0.0 {
+        return;
+    }
+    let cap = radius + 2.0;
+    let mut distance: Vec<f32> = values.iter().map(|v| if *v > 0.0 { cap } else { 0.0 }).collect();
+    for y in 0..h {
+        for x in 0..w {
+            let i = y * w + x;
+            let mut d = distance.get(i).copied().unwrap_or(0.0);
+            if x == 0 || y == 0 || x + 1 == w || y + 1 == h {
+                d = d.min(1.0);
+            }
+            if x > 0 {
+                d = d.min(distance.get(i - 1).copied().unwrap_or(0.0) + 1.0);
+            }
+            if y > 0 {
+                d = d.min(distance.get(i - w).copied().unwrap_or(0.0) + 1.0);
+            }
+            if x > 0 && y > 0 {
+                d = d.min(distance.get(i - w - 1).copied().unwrap_or(0.0) + std::f32::consts::SQRT_2);
+            }
+            if x + 1 < w && y > 0 {
+                d = d.min(distance.get(i - w + 1).copied().unwrap_or(0.0) + std::f32::consts::SQRT_2);
+            }
+            if let Some(value) = distance.get_mut(i) {
+                *value = d;
+            }
+        }
+    }
+    for y in (0..h).rev() {
+        for x in (0..w).rev() {
+            let i = y * w + x;
+            let mut d = distance.get(i).copied().unwrap_or(0.0);
+            if x + 1 < w {
+                d = d.min(distance.get(i + 1).copied().unwrap_or(0.0) + 1.0);
+            }
+            if y + 1 < h {
+                d = d.min(distance.get(i + w).copied().unwrap_or(0.0) + 1.0);
+            }
+            if x + 1 < w && y + 1 < h {
+                d = d.min(distance.get(i + w + 1).copied().unwrap_or(0.0) + std::f32::consts::SQRT_2);
+            }
+            if x > 0 && y + 1 < h {
+                d = d.min(distance.get(i + w - 1).copied().unwrap_or(0.0) + std::f32::consts::SQRT_2);
+            }
+            if let Some(value) = distance.get_mut(i) {
+                *value = d;
+            }
+        }
+    }
+    // Large radii soften narrow selections without making the center disappear.
+    let max_depth = distance.iter().copied().fold(0.0_f32, f32::max);
+    let span = radius.min((max_depth - 1.0).max(1.0));
+    for (value, d) in values.iter_mut().zip(distance) {
+        let t = ((d - 1.0) / span).clamp(0.0, 1.0);
+        *value *= t * t * (3.0 - 2.0 * t);
+    }
+}
